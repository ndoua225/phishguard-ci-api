# PhishGuard CI Agent API - Environment Variables
# Copy this file to .env and fill in the values

# Application
PHISHGUARD_APP_NAME=PhishGuard CI Agent API
PHISHGUARD_ENVIRONMENT=development

# Database (PostgreSQL)
PHISHGUARD_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/phishguard
PHISHGUARD_DATABASE_ECHO=false

# Security (CHANGE IN PRODUCTION!)
PHISHGUARD_SECRET_KEY=your-super-secret-key-at-least-32-chars
PHISHGUARD_TOTP_ENCRYPTION_KEY=your-fernet-key-44-chars-urlsafe-base64
PHISHGUARD_ALGORITHM=HS256
PHISHGUARD_ACCESS_TOKEN_EXPIRE_MINUTES=30
PHISHGUARD_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
PHISHGUARD_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Quotas
PHISHGUARD_MAX_INPUT_CHARS=1000
PHISHGUARD_MAX_NORMALIZED_CHARS=10000
PHISHGUARD_MAX_HERMES_CONTEXT_TOKENS=2048
PHISHGUARD_MAX_URLS_PER_ANALYSIS=10
PHISHGUARD_MAX_ANALYSES_PER_DAY=30

# Hermes (disabled by default per D21/K1)
PHISHGUARD_HERMES_ENABLED=false
PHISHGUARD_HERMES_TIMEOUT_SECONDS=10
PHISHGUARD_HERMES_MAX_RETRIES=0

# TemplateExplainer
PHISHGUARD_TEMPLATE_VERSION=1.0.0